rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student can read and write only their own saved progress.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Nothing else is open to the browser. The AI usage counters (aiUsage)
    // are only touched by the server-side function.
  }
}
